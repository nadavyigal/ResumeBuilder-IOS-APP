// Secrets.xcconfig.template — committed reference. Do NOT put real keys here.
// Copy this file to Secrets.xcconfig and fill in your values (Secrets.xcconfig is gitignored).

POSTHOG_API_KEY = phc_your_key_here
SUPABASE_ANON_KEY = your_supabase_anon_key_here

// Team installs, excluded from every activation metric. Leave neither empty:
// an empty allowlist counts every team install as a real user (see README).
// Comma-separated. Plus-aliases fold into the base address.
INTERNAL_TESTER_EMAILS =
// Comma-separated Supabase auth user IDs.
INTERNAL_TESTER_USER_IDS =
